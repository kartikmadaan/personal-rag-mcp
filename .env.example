# PostgreSQL + pgvector connection settings
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# Local Ollama & model configuration
OLLAMA_BASE_URL=http://localhost:11434/v1
GENERATOR_MODEL=llama3.2:3b
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Optional: only required when running `python scripts/eval.py --evaluator gemini`
# GEMINI_API_KEY=
